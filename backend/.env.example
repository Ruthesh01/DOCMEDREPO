# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/docmedrepo

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT Secrets (use long random strings in production) ───────────────────────
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret_min_32_chars

# ── Field Encryption (AES-256 — must be exactly 32+ chars) ───────────────────
FIELD_ENCRYPTION_SECRET=replace_with_32_char_encryption_secret_here

# ── AWS S3 ────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your-private-s3-bucket-name

# ── Firebase (FCM Push Notifications) ────────────────────────────────────────
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# ── SMTP (for 2FA OTP emails) ─────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# ── AI Analyzer Service ───────────────────────────────────────────────────────
AI_ANALYZER_URL=http://localhost:8000
AI_SERVICE_SECRET=replace_with_long_random_secret_min_32_chars

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,https://your-admin-dashboard.com

# ── Frontend (for password reset links) ───────────────────────────────────────
FRONTEND_URL=http://localhost:3000
